# Optional runtime AI synthesis. Without this key, the deployed demo uses its
# transparent grounded fallback and still shows the full evidence experience.
OPENAI_API_KEY=
MARKET_SIGNAL_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
MARKET_SIGNAL_DISCOVERY_MODEL=gpt-5.4-mini
MARKET_SIGNAL_MATCH_MODEL=gpt-5.4-mini
MARKET_SIGNAL_MATCH_EMBEDDING_MODEL=text-embedding-3-small
# Server-owned product entitlement. Invalid or missing values fail to Starter.
MARKET_SIGNAL_DEFAULT_PLAN=starter
# Temporary domain registry until account/workspace billing is connected.
# Example: {"myjam.co.uk":"agency"}
MARKET_SIGNAL_PLAN_REGISTRY_JSON={}
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
# Internal report-quality pilot. Keep false until human-review and owner-feedback
# tasks are deployed; the deterministic evaluator still runs for every report.
MARKET_SIGNAL_EVALUATION_PILOT_ENABLED=false
MARKET_SIGNAL_EVALUATION_PILOT_DOMAINS=
MARKET_SIGNAL_EVALUATION_PILOT_REPORT_IDS=
MARKET_SIGNAL_SEARCH_CHALLENGER_ENABLED=false

# Server-side Trigger.dev production key used only by authenticated callers.
# Trigger CLI deployment uses the signed-in CLI profile instead of this value.
# Your own Trigger.dev project. Never reuse the hosted Market Signal project.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Optional: set this only when using your own self-hosted Trigger.dev instance.
# Leave empty when using your own Trigger.dev Cloud project.
TRIGGER_API_URL=

# Shared server-to-server callback credential. Use the same random value of at
# least 32 characters on the VPS and in Trigger; it is not the Trigger secret key.
MARKET_SIGNAL_CALLBACK_TOKEN=
# Optional overlap token used only during a controlled callback-token rotation.
MARKET_SIGNAL_CALLBACK_TOKEN_PREVIOUS=

# Optional token for the Go CLI against a local or explicitly controlled API.
# Use a separate random value of at least 32 characters. Set the same value as
# MARKET_SIGNAL_API_TOKEN in the CLI shell; leave empty to disable CLI access.
MARKET_SIGNAL_API_TOKEN=

# Separate server-only credentials for the owner evaluation queue. Each must be
# at least 32 random non-whitespace characters and all three internal keys must
# differ or owner access fails closed.
MARKET_SIGNAL_OWNER_READ_TOKEN=
MARKET_SIGNAL_OWNER_WRITE_TOKEN=
MARKET_SIGNAL_MONITOR_READ_TOKEN=
MARKET_SIGNAL_MONITOR_ACK_TOKEN=

# Trigger-only: exact deployed VPS HTTPS origin, without a path.
MARKET_SIGNAL_APP_ORIGIN=

# VPS account identity. Leave disabled until both values are configured.
# Generate BETTER_AUTH_SECRET with at least 32 random bytes and keep it only in
# the deployment secret store. BETTER_AUTH_URL is the exact public HTTPS origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Stripe Billing for the hosted product. Keep every value server-side and use
# test-mode values until Checkout, signed webhooks, and the Portal are verified.
MARKET_SIGNAL_HOSTED_BILLING=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# Public Shopify app foundation. It remains entirely dormant unless every
# protected value is present and the explicit gate is true. The key ring maps
# version names to 32-byte base64 keys; never commit a real key.
MARKET_SIGNAL_SHOPIFY_APP=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=v1
SHOPIFY_TOKEN_ENCRYPTION_KEYS_JSON={}

# Optional server-side email delivery adapter for 15-minute price-watch batches.
# The endpoint must be HTTPS and accept docs/price-watch-email-webhook.md.
MARKET_SIGNAL_EMAIL_WEBHOOK_URL=
MARKET_SIGNAL_EMAIL_WEBHOOK_TOKEN=

# Operator-only company quota exemption. Keep disabled until our server-owned
# production Trigger key is registered and verified. No raw key belongs here.
MARKET_SIGNAL_INTERNAL_UNLIMITED=false
MARKET_SIGNAL_INTERNAL_TRIGGER_PROJECT_REF=
MARKET_SIGNAL_INTERNAL_TRIGGER_PROJECT_ID=
MARKET_SIGNAL_INTERNAL_TRIGGER_KEY_SHA256=
