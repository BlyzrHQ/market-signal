# Optional runtime AI synthesis. Without this key, the deployed demo uses its
# transparent grounded fallback and still shows the full evidence experience.
OPENAI_API_KEY=
MARKET_SIGNAL_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
MARKET_SIGNAL_DISCOVERY_MODEL=gpt-5.4-mini
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1

# Server-side only. Temporary unofficial exact-Page Meta provider while official
# Meta commercial-ad access is pending. Never expose this key to the browser.
METAPI_API_KEY=

# Optional official Ads Archive token. Commercial coverage varies by country.
META_AD_LIBRARY_ACCESS_TOKEN=
