# Copy to deploy/vps/market-signal.env on the VPS and set chmod 600.
MARKET_SIGNAL_DOMAIN=staging.example.com

# Generate new production values. Never reuse credentials pasted into chat.
MARKET_SIGNAL_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
MARKET_SIGNAL_EVALUATION_TOKEN=replace-with-a-different-32-character-random-value
MARKET_SIGNAL_EVALUATION_DISPATCH_ENABLED=false
TRIGGER_SECRET_KEY=replace-with-trigger-production-secret
OPENAI_API_KEY=replace-with-a-new-openai-project-key

# Temporary read-through migration for reports created before the VPS cutover.
# Remove all three values after the last legacy report has passed its 90-day expiry.
MARKET_SIGNAL_LEGACY_REPORT_RECOVERY_ENABLED=false
MARKET_SIGNAL_LEGACY_REPORT_BASE_URL=https://legacy.example.com
MARKET_SIGNAL_LEGACY_REPORT_SUNSET_AT=2026-12-31T00:00:00.000Z

# Model configuration.
MARKET_SIGNAL_DISCOVERY_MODEL=gpt-5.4-mini
MARKET_SIGNAL_MATCH_MODEL=gpt-5.4-mini
MARKET_SIGNAL_MATCH_EMBEDDING_MODEL=text-embedding-3-small
MARKET_SIGNAL_AD_MODEL=gpt-5.4-mini
MARKET_SIGNAL_MODEL=gpt-5.6-luna
MARKET_SIGNAL_EVALUATOR_MODEL=gpt-5.6-luna

# Optional providers. Leave blank to expose an honest unavailable state.
METAPI_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
