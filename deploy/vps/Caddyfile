{$MARKET_SIGNAL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		transport http {
			dial_timeout 10s
			# Agency matching has a 12-minute application budget and the worker
			# allows 12.5 minutes for transport. Keep the edge above both so Caddy
			# does not turn a still-valid match response into a retryable 504.
			response_header_timeout 780s
		}
	}

	log {
		output stdout
		format json
	}
}
