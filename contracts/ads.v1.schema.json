{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketsignal.dev/contracts/ads.v1.schema.json",
  "title": "Market Signal ad intelligence response v1",
  "type": "object",
  "required": ["ok", "block"],
  "properties": {
    "ok": { "const": true },
    "block": {
      "type": "object",
      "required": ["type", "id", "primaryDomain", "available", "provider", "observedAt", "companies", "limitation"],
      "properties": {
        "type": { "const": "ad-intelligence" },
        "id": { "const": "ad-intelligence" },
        "primaryDomain": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "companies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["domain", "brand", "summary", "recommendedAction", "platforms"],
            "properties": {
              "domain": { "type": "string", "minLength": 1 },
              "brand": { "type": "string", "minLength": 1 },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["platform", "status", "activeCreativeCount", "message", "evidenceUrls", "searchUrl"],
                  "properties": {
                    "platform": { "enum": ["Meta", "Google", "TikTok"] },
                    "status": { "enum": ["verified-active", "no-verified-result", "access-limited"] },
                    "activeCreativeCount": { "type": "integer", "minimum": 0 },
                    "message": { "type": "string" },
                    "evidenceUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
                    "searchUrl": { "type": "string", "format": "uri" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
