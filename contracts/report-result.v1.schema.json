{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketsignal.dev/contracts/report-result.v1.schema.json",
  "title": "Market Signal loop result",
  "oneOf": [
    { "$ref": "#/$defs/pending" },
    { "$ref": "#/$defs/terminal" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,119}$"
    },
    "publicId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "enum": ["starter", "solo", "growth", "agency"]
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requestId", "publicReportId", "primaryDomain", "status", "phase", "attempt", "heartbeatAt", "pollAfterSeconds"],
      "properties": {
        "state": { "const": "pending" },
        "requestId": { "$ref": "#/$defs/id" },
        "publicReportId": { "$ref": "#/$defs/publicId" },
        "primaryDomain": { "type": "string", "minLength": 3, "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "status": { "enum": ["queued", "running"] },
        "phase": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "heartbeatAt": { "$ref": "#/$defs/timestamp" },
        "pollAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "output", "decision", "competitors", "comparisons"],
      "properties": {
        "state": { "const": "terminal" },
        "output": { "$ref": "#/$defs/output" },
        "decision": { "$ref": "#/$defs/decision" },
        "competitors": { "$ref": "#/$defs/competitors" },
        "comparisons": { "$ref": "#/$defs/comparisons" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "functionId", "functionVersion", "requestId", "primaryDomain", "productPlan", "runId", "status", "report", "artifacts", "metrics", "evaluation", "failure", "startedAt", "finishedAt"],
      "properties": {
        "contractVersion": { "const": "1" },
        "functionId": { "const": "market-signal.report" },
        "functionVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/id" },
        "primaryDomain": { "type": "string", "minLength": 3, "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "productPlan": { "$ref": "#/$defs/plan" },
        "runId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["complete", "limited", "failed", "outcome_unknown"] },
        "report": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["publicId", "ownerPath", "status", "completedPhases", "limitedPhases"],
              "properties": {
                "publicId": { "$ref": "#/$defs/publicId" },
                "ownerPath": { "type": "string", "pattern": "^/reports/[a-f0-9]{32}$" },
                "status": { "enum": ["complete", "limited"] },
                "completedPhases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
                "limitedPhases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } }
              }
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "schemaVersion", "reference", "contentHash", "mediaType", "recordCount"],
            "properties": {
              "kind": { "enum": ["report", "comparisons", "competitor_scores", "evidence", "evaluation"] },
              "schemaVersion": { "$ref": "#/$defs/id" },
              "reference": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]{1,500}$" },
              "contentHash": { "$ref": "#/$defs/hash" },
              "mediaType": { "const": "application/json" },
              "recordCount": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparisonTarget", "publishedComparisons", "pricedComparisons", "competitorCount", "repairRounds", "usageStatus", "costMicrousd", "durationMs"],
          "properties": {
            "comparisonTarget": { "enum": [20, 50, 500, 1000] },
            "publishedComparisons": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "pricedComparisons": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "competitorCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "repairRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
            "usageStatus": { "enum": ["not_called", "known", "unknown"] },
            "costMicrousd": { "type": ["integer", "null"], "minimum": 0 },
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evaluationId", "evaluatorVersion", "resultHash"],
          "properties": {
            "status": { "enum": ["pending", "complete", "needs_human_review", "unavailable"] },
            "evaluationId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "evaluatorVersion": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "resultHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
          }
        },
        "failure": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" },
                "message": { "type": "string", "minLength": 1, "maxLength": 240 }
              }
            }
          ]
        },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "coverage", "competitorDomains", "limitations", "recommendedActions"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 240 },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "delivered", "percent"],
          "properties": {
            "target": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "delivered": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "competitorDomains": { "type": "array", "uniqueItems": true, "maxItems": 1000, "items": { "type": "string", "minLength": 3, "maxLength": 253 } },
        "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "recommendedActions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "amount", "currency"],
      "properties": {
        "display": { "type": "string", "minLength": 1, "maxLength": 120 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "quantity": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "amount", "unit"],
          "properties": {
            "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "minLength": 1, "maxLength": 20 }
          }
        }
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "title", "sourceUrl", "imageUrl", "observedAt", "price", "quantity"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "domain": { "type": "string", "minLength": 3, "maxLength": 253 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceUrl": { "type": "string", "pattern": "^https://", "maxLength": 2000 },
        "imageUrl": { "oneOf": [{ "type": "string", "pattern": "^https://", "maxLength": 2000 }, { "type": "null" }] },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "price": { "$ref": "#/$defs/price" },
        "quantity": { "$ref": "#/$defs/quantity" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "confidence", "score", "method", "claimType", "reasons", "contradictions", "sharedTerms", "category", "variant", "size", "model", "promptVersion"],
      "properties": {
        "verdict": { "enum": ["same_product", "close_substitute", "search_result"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "enum": ["ai-hybrid", "direct-web-search"] },
        "claimType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reasons": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 320 } },
        "contradictions": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 320 } },
        "sharedTerms": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "category": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
        "variant": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
        "size": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
        "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
        "promptVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 }
      }
    },
    "priceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position", "currency", "primaryAmount", "rivalAmount", "gapAmount", "gapPercent", "unitBasis", "unit", "primaryUnitAmount", "rivalUnitAmount", "unavailableReason", "summary", "detail", "note"],
      "properties": {
        "kind": { "enum": ["direct", "unit-normalized", "listed-gap", "listed-equal", "approved-unparsed", "both-observed", "one-observed", "none-observed"] },
        "position": { "enum": ["primary_lower", "rival_lower", "equal", "not_calculable"] },
        "currency": { "oneOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" }] },
        "primaryAmount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "rivalAmount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "gapAmount": { "type": ["number", "null"], "minimum": 0 },
        "gapPercent": { "type": ["number", "null"], "minimum": 0 },
        "unitBasis": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unit": { "type": ["string", "null"], "minLength": 1, "maxLength": 20 },
        "primaryUnitAmount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "rivalUnitAmount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unavailableReason": { "enum": ["currency", "format", "unparsed", "missing_price", null] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "detail": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "rationale", "source", "leverType", "model", "promptVersion", "evidenceKeys"],
      "properties": {
        "action": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "rationale": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "source": { "enum": ["ai", "deterministic", "unknown"] },
        "leverType": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
        "promptVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
        "evidenceKeys": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primaryProduct", "rivalProduct", "match", "priceComparison", "recommendation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "primaryProduct": { "$ref": "#/$defs/product" },
        "rivalProduct": { "$ref": "#/$defs/product" },
        "match": { "$ref": "#/$defs/match" },
        "priceComparison": { "$ref": "#/$defs/priceComparison" },
        "recommendation": { "$ref": "#/$defs/recommendation" }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "name", "comparisonCount", "comparisonSharePercent", "relationship", "confidence", "reason", "verificationScore", "websiteUrl"],
      "properties": {
        "domain": { "type": "string", "minLength": 3, "maxLength": 253 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "comparisonCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "comparisonSharePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "relationship": { "type": "string", "minLength": 1, "maxLength": 240 },
        "confidence": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "verificationScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "websiteUrl": { "oneOf": [{ "type": "string", "pattern": "^https://", "maxLength": 2000 }, { "type": "null" }] }
      }
    },
    "competitors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "items", "totalCount"],
      "properties": {
        "authoritative": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/competitor" } },
        "totalCount": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "items", "returnedCount", "totalCount", "directPriceCount", "manifestHash", "nextCursor", "pageUrl"],
      "properties": {
        "authoritative": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/comparison" } },
        "returnedCount": { "type": "integer", "minimum": 0, "maximum": 50 },
        "totalCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "directPriceCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "manifestHash": { "type": "string", "pattern": "^(?:|[a-f0-9]{64})$" },
        "nextCursor": { "type": ["string", "null"], "maxLength": 600 },
        "pageUrl": { "type": "string", "pattern": "^/api/reports/[a-f0-9]{32}/result/comparisons$" }
      }
    }
  }
}
